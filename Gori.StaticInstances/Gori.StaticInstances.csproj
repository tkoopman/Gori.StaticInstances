<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Disabled ImplicitUsings to force use of global:: where code is copied into source generator -->
    <ImplicitUsings>disable</ImplicitUsings>
    <DevelopmentDependency>true</DevelopmentDependency>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>

    <IsRoslynComponent>true</IsRoslynComponent>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Title>Gori.StaticInstances</Title>
    <Description>Source generator for making singletons and other static instances including using Lazy or Weak References</Description>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Authors>Tim Koopman</Authors>
    <PackageLicenseExpression>MIT-0</PackageLicenseExpression>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <RepositoryUrl>https://github.com/tkoopman/Gori.StaticInstances</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <PackageId>Gori.StaticInstances.Analyzer</PackageId>
    <PackageLicenseExpression>MIT-0</PackageLicenseExpression>
    <IsRoslynComponent>true</IsRoslynComponent>
    <DevelopmentDependency>true</DevelopmentDependency>
    <DefineConstants>$(DefineConstants);Gori_StaticInstances_EmitAttributes</DefineConstants>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <FileVersion>1.0.4.26304</FileVersion>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <Version>$(AssemblyVersion)</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Version>$(AssemblyVersion)-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="..\AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="NETStandard.Library" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Gori.Common.Roslyn" Version="2.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Gori.CompressedStatics" Version="2.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gori.StaticInstances.CodeFix" />
    <InternalsVisibleTo Include="Gori.StaticInstances.Testing" />
  </ItemGroup>

  <!-- Custom MSBuild targets to control NuGet packaging paths -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackGeneratorAndAttributes</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="PackGeneratorAndAttributes">
    <ItemGroup>
      <!-- Package the generator in the analyzer directory of the nuget package -->
      <TfmSpecificPackageFile Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <!-- Bundle Gori.CodeStringBuilder so it is available as part of the analyzer -->
      <TfmSpecificPackageFile Include="$(PkgGori_CodeStringBuilder)\lib\netstandard2.0\Gori.CodeStringBuilder.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <!-- Bundle Microsoft.Bcl.Memory (transitive dependency of Gori.CodeStringBuilder) -->
      <TfmSpecificPackageFile Include="$(PkgMicrosoft_Bcl_Memory)\lib\netstandard2.0\Microsoft.Bcl.Memory.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <TfmSpecificPackageFile Include="..\README.md">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Gori.CodeStringBuilder" Version="1.2.0" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.14" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="PolySharp" Version="1.16.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StyleCop.Analyzers" Version="1.3.151-beta">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
